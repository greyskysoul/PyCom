/* PyCom theme */
Screen {
    background: $background;
}

/* --- main layout ---------------------------------------------------------- */
#term-root {
    layout: vertical;
}

/* 终端区：横向摆放终端视图与（HEX 模式下的）右侧 ASCII 分栏 */
#term-area {
    height: 1fr;
    layout: horizontal;
}

#term {
    width: 1fr;
    height: 1fr;
    background: $term-bg;
    color: $term-fg;
    padding: 0;
}

/* 右侧 ASCII 分栏：只在 HEX 模式挂载，用分隔边框和稍浅底色区分。
   宽度由应用按“每行字节数 + 1 列分隔边框”动态设置（32 字节行 -> 33 列），
   这里的 33 只是首帧的默认值（如 32 字节/行）。*/
#hex-ascii-pane {
    width: 33;
    height: 1fr;
    background: $hex-bg;
    color: $term-fg;
    border-left: round $border;
    padding: 0;
    overflow: hidden;
}

/* 底部一行：状态文字 + 左下角“菜单”按钮（仅鼠标点击，不抢键盘焦点） */
#bottom {
    height: 1;
    background: $panel;
}

#status {
    width: 1fr;
    height: 1;
    background: $panel;
    color: $muted;
    text-style: bold;
    padding: 0 1;
}

#menu-btn {
    height: 1;
    min-width: 7;
    border: none;
    background: $accent-btn-bg;
    color: $accent-btn-fg;
    padding: 0 1;
    margin: 0;
    content-align: left middle;
    text-style: bold;
}

#menu-btn:hover,
#menu-btn:focus {
    background: $accent-btn-hover-bg;
    color: $accent-btn-fg;
    text-style: bold;
}

/* 普通按钮：仅微调底色提升对比度（不动边框/布局） */
Button {
    background: $button-bg;
}

/* hover：比常态略浅，提供悬停反馈（App CSS 会覆盖 Textual 默认 hover） */
Button:hover {
    background: $hover-bg;
}
Input:hover {
    background: $hover-bg;
}
SelectCurrent:hover {
    background: $hover-bg;
}
/* 重点色按钮（左下角“菜单”、各对话框主按钮如“连接/保存”）：统一使用主题文件
   的 accent-btn-* 变量（Textual 默认的 primary-muted 在深色下偏灰，故显式覆盖）。 */
Button.-primary {
    background: $accent-btn-bg;
    color: $accent-btn-fg;
}
Button.-primary:hover {
    background: $accent-btn-hover-bg;
    color: $accent-btn-fg;
}

/* 兼容（ANSI）模式下 Textual 默认主题会在按下时给 -active 按钮加一圈 blank 边框
   （blank 虽不可见但占位），紧凑按钮会瞬间从 1 行“变大”到 3 行。这里强制无边框。 */
Button:ansi.-style-default.-textual-compact,
Button:ansi.-style-default.-textual-compact:hover,
Button:ansi.-style-default.-textual-compact:focus,
Button:ansi.-style-default.-textual-compact.-active {
    border: none !important;
}

/* --- 16 进制接收/发送输入条（仅在 HEX 模式开启时挂载） ----------------------- */
#hex-bar {
    height: auto;
    background: $hex-bg;
    border-top: round $hex-bar-border;
    padding: 0 1;
}

/* 多行 16 进制输入区：自动按字节加空格并按宽度每行 4/8/16 字节排版 */
#hex-bar TextArea {
    width: 1fr;
    height: 3;
    background: $hex-input-bg;
    color: $control-fg;
    border: none;
    padding: 0 1;
}

#hex-bar TextArea:focus {
    background: $hex-input-focus-bg;
}

#hex-bar Button {
    width: auto;
    margin-top: 1;
    /* 与下方状态栏之间留出间隔，避免按钮和状态栏粘在一起 */
    margin-bottom: 1;
}

/* --- generic modal box ------------------------------------------------------ */
Vertical#conn-box, Vertical#options-box, Vertical#xfer-box,
Vertical#help-box, Vertical#picker-box, Vertical#confirm {
    width: auto;
    max-width: 88;
    height: auto;
    max-height: 90%;
    background: $surface;
    /* round 圆角边框：Windows Terminal / 现代 conhost 均正常显示 */
    border: round $border;
    padding: 1 2;
    margin: 2 4;
}

Static#conn-title, Static#options-title, Static#xfer-title,
Static#help-title, Static#picker-title, Static#confirm-title {
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

/* --- forms ------------------------------------------------------------------ */
.form-row {
    height: auto;
    margin: 1 0 0 0;
}

.form-label {
    width: 16;
    content-align: left middle;
    color: $label;
}

.form-row Input {
    width: 18;
    /* 同行后面还有项目时留出间隔，避免控件与下一个标签/控件贴在一起 */
    margin-right: 2;
}

.form-row Select {
    width: 18;
    margin-right: 2;
}

#conn-box DataTable {
    height: 8;
    margin: 1 0 0 0;
}

/* 表头：独立底色 + 加粗，与表体区分 */
DataTable > .datatable--header {
    background: $table-header-bg;
    color: $table-header-fg;
    text-style: bold;
}

/* 连接页输入框与选项页一致：单行紧凑、带底色区分字段 */
#conn-box .form-row Input {
    background: $control-bg;
    color: $control-fg;
    padding: 0 1;
    margin: 0;
}

#conn-box .form-row Input:focus {
    background: $control-focus-bg;
    border: none;
}

#conn-box .form-row Input > .input--placeholder {
    color: $placeholder;
}

/* 按钮另起一行并左对齐 */
#conn-buttons {
    margin-top: 1;
    height: auto;
}

#conn-error {
    color: $error;
    height: 1;
    margin-top: 1;
}

/* 连接页“高级参数”折叠容器：去掉内置边框/缩进，保持字段列对齐 */
#conn-box Collapsible {
    border-top: none;
    padding-bottom: 0;
    padding-left: 0;
}

#conn-box Collapsible > Contents {
    padding: 0;
}

#conn-box CollapsibleTitle {
    color: $label;
    text-style: bold;
}

/* 去掉 Collapsible 默认的 :focus-within $foreground 5% background-tint：
   叠加后与未聚焦字段底色几乎相同，字段会“融进”块背景。 */
#conn-box Collapsible:focus-within {
    background-tint: transparent;
}

/* 折叠容器内第一行字段紧贴标题，避免多出一行空隙 */
#conn-box Collapsible .form-row:first-of-type {
    margin-top: 0;
}

/* 选项/连接盒体收紧到内容宽度：即使行内并排两对字段也不撑满/溢边 */
Vertical#options-box, Vertical#conn-box {
    max-width: 80;
}

/* 发送/接收界面盒体稍宽，让路径/目录输入框更宽敞 */
Vertical#xfer-box {
    max-width: 100;
}

/* --- help / main menu --------------------------------------------------------- */
#help-box {
    max-width: 66;
}

/* 左下角浮动功能菜单：推入的 Screen + 半透明背景，底层终端与状态栏
   变暗但可见；&:ansi 时退回透明（老式终端不变暗，内容仍透出）。 */
MainMenuScreen {
    background: $background 60%;
    align: left bottom;
    &:ansi {
        background: transparent;
    }
}

#menu-popup {
    width: auto;
    min-width: 24;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    background: $surface;
    border: round $border;
    /* \u9876\u90e8/\u5e95\u90e8\u5404\u7559 1 \u884c\uff1a\u9876\u90e8\u66ff\u4ee3\u539f\u6807\u9898\u5360\u4f4d\uff0c\u5e95\u90e8\u907f\u5f00\u72b6\u6001\u680f\uff08#bottom\uff09 */
    padding: 1 0 1 0;
    margin: 0 0 1 0;
}

#menu-popup Button.menu-item {
    width: 100%;
    min-width: 0;
    height: 1;
    padding: 0 2;
    border: none;
    background: transparent;
    color: $term-fg;
    text-align: left;
    content-align: left middle;
}

#menu-popup Button.menu-item:hover {
    background: $control-bg;
}

#menu-popup Button.menu-item:focus {
    background: $highlight-bg;
    color: $highlight-fg;
    text-style: bold;
}

#help-body {
    height: auto;
    margin: 0 0 1 0;
}

/* 可聚焦菜单项：单行、整行高亮表示光标所在 */
#help-body Button.menu-item {
    width: 100%;
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $term-fg;
    text-align: left;
    content-align: left middle;
}

#help-body Button.menu-item:hover {
    background: $control-bg;
}

#help-body Button.menu-item:focus {
    background: $highlight-bg;
    color: $highlight-fg;
    text-style: bold;
}

#help-footer {
    color: $muted;
}

/* 菜单底部：版本 / 作者 / GitHub 仓库提示 */
#help-about {
    margin-top: 1;
}

#help-about,
#help-repo {
    color: $faint;
}

/* 菜单左下角“返回”按钮 */
#menu-back {
    width: auto;
    min-width: 10;
    margin-top: 1;
}

/* --- options ------------------------------------------------------------------ */
#options-box {
    max-width: 80;
    padding: 0 2;  /* 去掉上下内边距，让小终端也能容纳整页 */
}

#options-body {
    height: 1fr;
    max-height: 100%;
}

/* 选项页 Tab 页：内容区占满剩余高度，超高时在页内滚动 */
#options-body TabPane {
    height: 1fr;
    overflow-y: auto;
}
#options-body ContentTabs {
    /* 用 $surface 而非 $panel：亮色主题下 $panel 是灰色，会让 tab 条发灰 */
    background: $surface;
}

/* 输入行之间不再隔行（紧凑）；仅在与上方开关组之间留一行分隔 */
#options-body .form-row {
    margin: 0;
}

#options-body .form-row:first-of-type {
    margin-top: 1;
}

/* 选项页紧凑布局：Checkbox/Input 以 compact 单行显示 */
#options-body Checkbox {
    margin: 0;
    background: transparent;
    color: $checkbox-fg;
}

#options-body Checkbox:focus {
    background-tint: $foreground 8%;
}

/* 焦点/悬停时整行高亮 */
#options-body Checkbox:focus > .toggle--label,
#options-body Checkbox:hover > .toggle--label {
    background: $highlight-bg;
    color: $highlight-fg;
    text-style: bold;
}

#options-body Checkbox.-on {
    color: $text;
}

/* 空心圆（未选）/ 实心圆（选中）标记 */
#options-body Checkbox > .toggle--button {
    background: transparent;
    color: $toggle-off;
}

#options-body Checkbox.-on > .toggle--button {
    color: $text-success;
}

#options-body Input {
    background: $control-bg;
    color: $control-fg;
    padding: 0 1;
    margin: 0;
}

#options-body Input:focus {
    background: $control-focus-bg;
    border: none;
}

#options-body Input > .input--placeholder {
    color: $placeholder;
}

/* 下拉框与 Input 外观一致：底色填充、无边框、单行紧凑 */
#options-body SelectCurrent {
    background: $control-bg;
    color: $control-fg;
    padding: 0 0 0 1;
    height: 1;
}

#options-body Select:focus > SelectCurrent,
#options-body SelectCurrent:focus {
    background: $control-focus-bg;
}

#options-body SelectCurrent > Static#label {
    color: $control-fg;
}

#options-body SelectCurrent .arrow {
    color: $placeholder;
    padding: 0 0 0 1;
}

/* 下拉展开列表 */
#options-body Select > SelectOverlay {
    border: round $border;
    background: $panel;
    max-height: 8;
    padding: 0;
}

#options-body SelectOverlay > .option-list--option {
    padding: 0 1;
}

#options-body SelectOverlay > .option-list--option-highlighted {
    background: $highlight-bg;
    color: $highlight-fg;
    text-style: bold;
}

#options-buttons, #xfer-buttons, #picker-buttons, #confirm-buttons {
    margin-top: 1;
    height: auto;
}

/* 发送/接收界面：路径/目录/文件名输入框单行并占满剩余宽度 */
#xfer-box .form-row Input {
    width: 1fr;
    height: 1;
    background: $control-bg;
    color: $control-fg;
    padding: 0 1;
    border: none;
    margin: 0;
}

#xfer-box .form-row Input:focus {
    background: $control-focus-bg;
    border: none;
}

#xfer-state {
    height: auto;
    margin-top: 1;
    color: $accent;
}

#picker-tree {
    height: 16;
    margin-top: 1;
    border: round $border;
}

#picker-tree DataTable {
    height: 1fr;
}

#picker-nav {
    height: auto;
    margin-top: 1;
}

#picker-nav Button {
    /* 后退/前进/home// 四个按钮：尽量短但宽度一致 */
    min-width: 8;
    margin-right: 1;
}

#picker-buttons Button {
    /* 底部动作按钮宽度一致，避免一个长一个短 */
    min-width: 16;
    margin-right: 1;
}

#picker-path {
    height: 1;
    margin-top: 1;
    background: $control-bg;
    color: $control-fg;
    padding: 0 1;
    border: none;
}

#picker-path:focus {
    background: $control-focus-bg;
    border: none;
}

#confirm {
    width: 54;
    max-width: 60;
}

#confirm-message {
    margin: 1 0;
}

/* === compact (small window) simple layouts ====================================
   终端太小时，选项/连接模态自动重建为“单列、整行字段 + 可滚动”的简洁面板，
   保证小窗口下仍能操作所有字段（通过 .compact 类，见 screens/base.py）。 */
Vertical#options-box.compact,
Vertical#conn-box.compact {
    width: 100%;
    height: 1fr;
    /* 与普通（富）布局的窗口宽度保持一致：窄窗口下铺满，宽窗口下不再无限拉宽 */
    max-width: 80;
    max-height: 100%;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $compact-bg;
}

/* 标题与按钮固定，中间字段区占满剩余空间并允许滚动 */
Vertical#options-box.compact #options-body,
Vertical#conn-box.compact #conn-body {
    height: 1fr;
    margin: 0 0 1 0;
}

/* 简洁模式整页共用 $compact-bg：上面的 ContentTabs 规则用的是 $surface（富布局下
   等于盒子底色），简洁模式的盒子是 $compact-bg，不覆盖就会在 tab 条处留下一条
   异色横带。 */
Vertical#options-box.compact #options-body ContentTabs {
    background: $compact-bg;
}

.compact .c-row {
    height: auto;
    width: 100%;
    margin: 0;
}

.compact .c-label {
    width: 12; /* 各行列标签定宽右对齐，输入框/下拉框从同一列开始 */
    min-width: 0;
    color: $label;
    content-align: right middle;
    margin-right: 2;
}

.compact .c-row Input,
.compact .c-row Select {
    width: 1fr;
}

/* 简洁模式选项页：下拉框/输入框沿用原有底色外观 */
#options-box.compact .c-row Select > SelectOverlay {
    border: round $border;
    background: $panel;
    max-height: 8;
    padding: 0;
}

#options-box.compact SelectOverlay > .option-list--option {
    padding: 0 1;
}

#options-box.compact SelectOverlay > .option-list--option-highlighted {
    background: $highlight-bg;
    color: $highlight-fg;
    text-style: bold;
}

/* 简洁模式连接页：下拉端口 + 输入框与选项页视觉一致 */
#conn-box.compact .c-row Input {
    background: $control-bg;
    color: $control-fg;
    padding: 0 1;
    margin: 0;
}

#conn-box.compact .c-row Input:focus {
    background: $control-focus-bg;
    border: none;
}

#conn-box.compact .c-row Input > .input--placeholder {
    color: $placeholder;
}

#conn-box.compact SelectCurrent {
    background: $control-bg;
    color: $control-fg;
    padding: 0 0 0 1;
    height: 1;
}

#conn-box.compact .c-row Select:focus > SelectCurrent,
#conn-box.compact SelectCurrent:focus {
    background: $control-focus-bg;
}

#conn-box.compact SelectCurrent > Static#label {
    color: $control-fg;
}

#conn-box.compact SelectCurrent .arrow {
    color: $placeholder;
    padding: 0 0 0 1;
}

#conn-box.compact Select > SelectOverlay {
    border: round $border;
    background: $panel;
    max-height: 8;
    padding: 0;
}

#conn-box.compact SelectOverlay > .option-list--option {
    padding: 0 1;
}

#conn-box.compact SelectOverlay > .option-list--option-highlighted {
    background: $highlight-bg;
    color: $highlight-fg;
    text-style: bold;
}

/* === 功能菜单 / 退出确认：小窗口切换（见 screens/base.py ResponsiveCompact） =========
   窗口太小时给根节点加 .compact 类：整屏/整宽、去边距去边框；选项与连接页已在
   上面定义 .compact，这里为 help-box 与 confirm 补齐。 */
Vertical#help-box.compact,
Vertical#confirm.compact {
    width: 100%;
    max-width: 100%;
    margin: 0;
    border: none;
    background: $compact-bg;
}

/* 文件/目录选择器与协议选择器：小窗口时切换为整宽紧凑布局 */
Vertical#picker-box.compact {
    width: 100%;
    max-width: 100%;
    height: 1fr;
    max-height: 100%;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $compact-bg;
}

Vertical#picker-box.compact #picker-tree {
    height: 1fr;
}

/* 功能菜单紧凑布局：占满整屏，标题/提示固定，字段区占满剩余空间并允许滚动；
   最大宽度与标准模式一致（66 列），窗口较宽时菜单不会被拉得过宽 */
Vertical#help-box.compact {
    height: 1fr;
    max-height: 100%;
    max-width: 66;
    padding: 0 1;
}

Vertical#help-box.compact #help-body {
    height: 1fr;
    margin: 0 0 1 0;
}

/* 退出确认紧凑布局：整宽、贴近顶部，消息自动换行不超界 */
Vertical#confirm.compact {
    height: auto;
    max-height: 100%;
    padding: 1 2;
}

Vertical#confirm.compact #confirm-message {
    margin: 1 0;
}

/* === 通知提示（toast）========================================================
   未连接端口 / HEX 模式等提示默认弹在右下角，会盖住状态区；这里把它们移到
   左下角显示。Toast 由 Textual 内部挂载：ToastRack 控制整叠位置，真正的横向
   对齐在 ToastHolder 上（width:1fr + align:right），所以两者都要覆盖。
   任意键关闭在 app.py 的 _on_key 里通过 clear_notifications() 处理。 */
ToastRack {
    align: left bottom;
}

ToastHolder {
    align: left top;
}